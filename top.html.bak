<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>WebChat - قائمة التوب VIP</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="css/top.css">
</head>
<body>

    <div class="fade-in">
        <!-- الشريط العلوي -->
        <header class="top-header">
            <div class="user-balance">
                <i class="fa-solid fa-coins" style="color: var(--gold);"></i>
                <span id="coin-balance">1,000</span> <span style="font-size: 11px; opacity: 0.8;">كوينز</span>
            </div>
            
            <div class="platform-brand">
                <img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=150&q=80" alt="Logo" class="platform-logo-img">
                <span class="platform-title">WebChat</span>
            </div>

            <div class="header-actions">
                <a href="main.html" class="support-icon-btn" title="الرئيسية" style="color: var(--gold); font-size: 20px; text-decoration: none;">
                    <i class="fa-solid fa-house"></i>
                </a>
            </div>
        </header>

        <!-- المحتوى الرئيسي للتوب -->
        <main class="main-content">
            
            <div class="leaderboard-title-card">
                <h2>👑 لوحة الشرف الملكية (VIP) 👑</h2>
                <p>أساطير موقع ويب شات وأكثر اللاعبين جمعاً للكوينزات من قاعدة البيانات</p>
            </div>

            <!-- قائمة توب الأشخاص الحقيقية التي ستمتلئ برمجياً من Supabase -->
            <div id="leaderboard-container" class="leaderboard-list">
                <div style="text-align: center; color: var(--gold); padding: 30px; font-size: 15px;">
                    <i class="fa-solid fa-spinner fa-spin"></i> جاري جلب أساطير الموقع من قاعدة البيانات...
                </div>
            </div>

        </main>
    </div>

    <!-- الشريط السفلي الثابت -->
    <nav class="bottom-nav">
        <a href="main.html" class="nav-item">
            <i class="fa-solid fa-house"></i>
            <span>الرئيسية</span>
        </a>
        <a href="top.html" class="nav-item active">
            <i class="fa-solid fa-trophy"></i>
            <span>التوب</span>
        </a>
        <a href="search.html" class="nav-item">
            <i class="fa-solid fa-magnifying-glass"></i>
            <span>البحث</span>
        </a>
        <a href="notifications.html" class="nav-item">
            <i class="fa-solid fa-bell"></i>
            <span>الإشعارات</span>
        </a>
        <a href="membership.html" class="nav-item">
            <i class="fa-solid fa-gem"></i>
            <span>العضوية</span>
        </a>
        <a href="profile.html" class="nav-item">
            <i class="fa-solid fa-user"></i>
            <span>حسابي</span>
        </a>
    </nav>

    <!-- استدعاء Supabase والسكربت الخاص بجلب البيانات الحقيقية -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            const container = document.getElementById("leaderboard-container");
            const currentUser = localStorage.getItem("webchat_username");

            try {
                // جلب المستخدمين مرتبين تنازلياً حسب الكوينز من جدول profiles في قاعدة بيانات Supabase
                const { data, error } = await window.supabaseClient
                    .from('profiles')
                    .select('username, display_name, coins, avatar_url')
                    .order('coins', { ascending: false })
                    .limit(10);

                if (error) {
                    console.error("خطأ في جلب بيانات التوب:", error);
                    container.innerHTML = `<div style="text-align: center; color: #ff4d4d; padding: 20px;">تعذر تحميل التوب حالياً، تأكد من اتصال قاعدة البيانات.</div>`;
                    return;
                }

                if (!data || data.length === 0) {
                    container.innerHTML = `<div style="text-align: center; color: var(--text-muted); padding: 20px;">لا يوجد مستخدمون مسجلون بعد. كن أول المنضمين!</div>`;
                    return;
                }

                container.innerHTML = ""; // تفريغ رسالة التحميل

                data.forEach((user, index) => {
                    const rank = index + 1;
                    let rankClass = "";
                    if (rank === 1) rankClass = "rank-1";
                    else if (rank === 2) rankClass = "rank-2";
                    else if (rank === 3) rankClass = "rank-3";

                    // صورة افتراضية فخمة في حال لم يكن للمستخدم صورة مرفوعة
                    const avatar = user.avatar_url || "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80";
                    const displayName = user.display_name || user.username || "مستخدم فخم";
                    const handle = user.username ? `@${user.username}` : "@member";

                    const itemHTML = `
                        <div class="leaderboard-item ${rankClass}">
                            <div class="user-info-group">
                                <div class="rank-badge">${rank}</div>
                                <img src="${avatar}" alt="Avatar" class="user-avatar">
                                <div class="user-details">
                                    <h4>${displayName} ${rank === 1 ? '👑' : ''}</h4>
                                    <span>${handle}</span>
                                </div>
                            </div>
                            <div class="user-coins-display">
                                <i class="fa-solid fa-coins" style="color: var(--gold);"></i>
                                <span>${Number(user.coins || 0).toLocaleString()}</span>
                            </div>
                        </div>
                    `;
                    container.innerHTML += itemHTML;
                });

            } catch (err) {
                console.error("خطأ غير متوقع:", err);
                container.innerHTML = `<div style="text-align: center; color: #ff4d4d; padding: 20px;">حدث خطأ أثناء الاتصال بقاعدة البيانات.</div>`;
            }
        });
    </script>
</body>
</html>
